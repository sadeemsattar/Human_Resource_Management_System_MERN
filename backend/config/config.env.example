# Copy this file to backend/config/config.env and fill in real values.
# The server loads it via dotenv (see backend/server.js), so start the
# backend from the backend/ directory.

# Express server port
PORT=5000

# MySQL connection (schema: backend/db/hrDb.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_DATABASE=hr

# Secret used to sign JWT access tokens
JWT_SECRET=change-me-to-a-long-random-string

# Gmail account used by Nodemailer to send registration emails
# (use an app password, not the account password)
SMTP_USER=example@gmail.com
SMTP_PASS=your-gmail-app-password

# Organization IP allowed to mark QR attendance (see backend/middleware/authIp.js)
ORG_IP=128.0.0.1
